<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Forgot Password – CarHospi</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <div class="admin-login-page">
      <div class="login-card">
        <div class="login-brand">
          <a href="/" class="login-logo">Car<span class="logo-accent">Hospi</span></a>
          <div class="login-role-badge">Admin Portal</div>
        </div>

        <h1 class="login-title">Forgot Password</h1>
        <p class="login-subtitle">Enter your admin email to receive a password reset link.</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-error">⚠️ <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="login-success">✅ <%= success %></div>
        <% } %>

        <form action="/admin/forgot-password" method="POST" class="login-form">
          <input
            type="email"
            name="email"
            placeholder="Admin email address"
            class="login-input"
            required
            autocomplete="email"
          />
          <button type="submit" class="login-btn">Send Reset Link →</button>
        </form>

        <div class="login-hint">
          <p style="margin-top:10px;">
            Remember your password? <a href="/admin/login">Back to Login</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
