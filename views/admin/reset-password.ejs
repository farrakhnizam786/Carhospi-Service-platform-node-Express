<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Reset Password – CarHospi</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <div class="admin-login-page">
      <div class="login-card">
        <div class="login-brand">
          <a href="/" class="login-logo">Car<span class="logo-accent">Hospi</span></a>
          <div class="login-role-badge">Admin Portal</div>
        </div>

        <h1 class="login-title">Reset Password</h1>
        <p class="login-subtitle">Enter your new password below to complete the reset.</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-error">⚠️ <%= error %></div>
        <% } %>

        <form action="/admin/reset-password/<%= token %>" method="POST" class="login-form">
          <input
            type="password"
            name="password"
            placeholder="New password"
            class="login-input"
            required
            minlength="6"
            autocomplete="new-password"
          />
          <input
            type="password"
            name="confirmPassword"
            placeholder="Confirm new password"
            class="login-input"
            required
            minlength="6"
            autocomplete="new-password"
          />
          <button type="submit" class="login-btn">Reset Password →</button>
        </form>

        <div class="login-hint">
          <p style="margin-top:10px;">
            <a href="/admin/login">← Back to Login</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
