<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard – CarHospi</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>

    <!-- ── Topbar ── -->
    <header class="topbar">
      <a href="/admin/dashboard" class="topbar-logo">
        Car<span class="logo-accent">Hospi</span>
        <span class="role-pill">Admin</span>
      </a>
      <div class="topbar-right">
        <!-- Avatar + name -->
        <div style="display:flex;align-items:center;gap:10px;" class="topbar-user">
          <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#e8202a,#ff4d57);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;color:#fff;flex-shrink:0;">
            <%= (admin.name || "A").charAt(0).toUpperCase() %>
          </div>
          <div>
            <div style="color:#fff;font-weight:700;font-size:.9rem;"><%= admin.name %></div>
            <div style="color:var(--muted);font-size:.78rem;"><%= admin.email %></div>
          </div>
        </div>
        <a href="/admin/bookings" class="topbar-link">📋 Bookings</a>
        <form action="/admin/logout" method="POST" style="margin:0;">
          <button type="submit" class="logout-btn">Logout</button>
        </form>
      </div>
    </header>

    <!-- ── Page ── -->
    <div class="page-wrap">

      <div class="page-header">
        <div>
          <h1>Admin <span>Dashboard</span></h1>
          <p class="page-subtitle">Manage services and monitor bookings</p>
        </div>
        <a href="/admin/bookings" class="btn-primary-admin">View All Bookings →</a>
      </div>

      <div class="nav-tabs">
        <a href="#" class="tab-link active" data-tab="add-service">➕ Add Service</a>
        <a href="#" class="tab-link" data-tab="all-services">🗂 All Services</a>
        <a href="#" class="tab-link" data-tab="site-settings">⚙️ Settings</a>
      </div>

      <!-- ── Add Service Tab ── -->
      <div id="add-service" class="tab-content active">
        <div class="admin-section">
          <h3>Add New Service</h3>
          <form id="add-service-form" class="admin-form">
            <div class="form-group">
              <label for="service-name">Service Name</label>
              <input
                type="text"
                id="service-name"
                class="admin-input"
                placeholder="e.g., Oil Change"
                required
              />
            </div>
            <div class="form-group">
              <label for="service-description">Description</label>
              <textarea
                id="service-description"
                class="admin-textarea"
                placeholder="Describe what this service includes…"
                required
              ></textarea>
            </div>
            <div class="form-group">
              <label for="service-image">Image URL</label>
              <input
                type="url"
                id="service-image"
                class="admin-input"
                placeholder="https://example.com/image.jpg"
                required
              />
            </div>
            <button type="submit" class="form-submit-btn">Add Service</button>
            <p id="add-message" class="form-msg"></p>
          </form>
        </div>
      </div>

      <!-- ── All Services Tab ── -->
      <div id="all-services" class="tab-content">
        <div class="admin-section">
          <h3>All Services</h3>
          <div class="services-grid" id="services-container">
            <p style="color:var(--muted);">Loading services…</p>
          </div>
        </div>
      </div>

      <!-- ── Settings Tab ── -->
      <div id="site-settings" class="tab-content">
        <div class="admin-section">
          <h3>Site Settings</h3>
          <form id="settings-form" class="admin-form">
            <div class="form-group">
              <label for="contact-phone">Contact Phone</label>
              <input type="text" id="contact-phone" class="admin-input" required />
            </div>
            <div class="form-group">
              <label for="contact-email">Contact Email</label>
              <input type="email" id="contact-email" class="admin-input" required />
            </div>
            <div class="form-group">
              <label for="contact-address">Contact Address</label>
              <input type="text" id="contact-address" class="admin-input" required />
            </div>
            <button type="submit" class="form-submit-btn">Save Settings</button>
            <p id="settings-message" class="form-msg"></p>
          </form>
        </div>
      </div>

    </div><!-- /page-wrap -->

    <div class="toast" id="toast"></div>

    <script>
      // ── Tab switching ────────────────────────────────────────────
      document.querySelectorAll(".tab-link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const tabName = link.getAttribute("data-tab");
          document.querySelectorAll(".tab-link").forEach(l => l.classList.remove("active"));
          document.querySelectorAll(".tab-content").forEach(t => t.classList.remove("active"));
          link.classList.add("active");
          document.getElementById(tabName).classList.add("active");
          if (tabName === "all-services") loadServices();
          if (tabName === "site-settings") loadSettings();
        });
      });

      // ── Add Service ──────────────────────────────────────────────
      document.getElementById("add-service-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const name        = document.getElementById("service-name").value;
        const description = document.getElementById("service-description").value;
        const image       = document.getElementById("service-image").value;
        const msgEl       = document.getElementById("add-message");

        try {
          const res  = await fetch("/admin/services", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, description, image }),
          });
          const data = await res.json();

          if (res.ok) {
            msgEl.className = "form-msg success";
            msgEl.textContent = "✓ Service added successfully!";
            document.getElementById("add-service-form").reset();
            showToast("Service added!", "success");
            setTimeout(() => { msgEl.style.display = "none"; }, 3500);
          } else {
            msgEl.className = "form-msg error";
            msgEl.textContent = "✗ " + data.error;
          }
          msgEl.style.display = "block";
        } catch {
          msgEl.className = "form-msg error";
          msgEl.textContent = "✗ Something went wrong";
          msgEl.style.display = "block";
        }
      });

      // ── Load Services ────────────────────────────────────────────
      async function loadServices() {
        try {
          const res = await fetch("/api/admin/services");
          if (res.ok) {
            const services = await res.json();
            displayServices(services);
          }
        } catch {
          document.getElementById("services-container").innerHTML =
            '<p style="color:#f87171;">Failed to load services.</p>';
        }
      }

      function displayServices(services) {
        const container = document.getElementById("services-container");
        if (!services.length) {
          container.innerHTML = '<div class="empty-state"><span class="icon">🔧</span><p>No services added yet.</p></div>';
          return;
        }
        container.innerHTML = services.map(s => `
          <div class="service-card">
            <img src="${s.image}" alt="${s.name}" />
            <div class="service-card-body">
              <h3>${s.name}</h3>
              <p>${s.description}</p>
              <button class="delete-btn" onclick="deleteService('${s._id}')">🗑 Delete</button>
            </div>
          </div>
        `).join("");
      }

      async function deleteService(id) {
        if (!confirm("Delete this service? This cannot be undone.")) return;
        try {
          const res = await fetch(`/admin/services/${id}`, { method: "DELETE" });
          if (res.ok) { loadServices(); showToast("Service deleted", "success"); }
          else showToast("Delete failed", "error");
        } catch { showToast("Network error", "error"); }
      }

      // ── Load & Update Settings ──────────────────────────────────────────────
      async function loadSettings() {
        try {
          const res = await fetch("/admin/settings");
          if (res.ok) {
            const data = await res.json();
            document.getElementById("contact-phone").value = data.contactPhone || "";
            document.getElementById("contact-email").value = data.contactEmail || "";
            document.getElementById("contact-address").value = data.contactAddress || "";
          }
        } catch {
          showToast("Failed to load settings", "error");
        }
      }

      document.getElementById("settings-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const contactPhone = document.getElementById("contact-phone").value;
        const contactEmail = document.getElementById("contact-email").value;
        const contactAddress = document.getElementById("contact-address").value;
        const msgEl = document.getElementById("settings-message");

        try {
          const res = await fetch("/admin/settings", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ contactPhone, contactEmail, contactAddress }),
          });
          if (res.ok) {
            msgEl.className = "form-msg success";
            msgEl.textContent = "✓ Settings updated!";
            showToast("Settings updated!", "success");
            setTimeout(() => { msgEl.style.display = "none"; }, 3500);
          } else {
            msgEl.className = "form-msg error";
            msgEl.textContent = "✗ Failed to update settings";
          }
          msgEl.style.display = "block";
        } catch {
          msgEl.className = "form-msg error";
          msgEl.textContent = "✗ Something went wrong";
          msgEl.style.display = "block";
        }
      });

      // ── Toast ────────────────────────────────────────────────────
      function showToast(msg, type = "success") {
        const t = document.getElementById("toast");
        t.textContent = msg;
        t.className = `toast ${type}`;
        requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add("show")));
        setTimeout(() => t.classList.remove("show"), 3200);
      }
    </script>
  </body>
</html>
