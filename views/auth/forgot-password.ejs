<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password – CarHospi</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>

    <section>
      <div class="container" style="max-width: 460px; margin-top: 40px;">
        <h2>Forgot Password</h2>
        <p style="color: var(--muted, #8a8aa8); margin: 10px 0 20px; font-size: .93rem; line-height: 1.6;">
          Enter your registered email address and we'll send you a link to reset your password.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: #f87171; margin: 10px 0;"><%= error %></p>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
        <p style="color: #4ade80; margin: 10px 0;"><%= success %></p>
        <% } %>

        <form action="/forgot-password" method="POST" style="display: grid; gap: 12px; margin-top: 14px;">
          <input type="email" name="email" placeholder="Enter your email" required style="padding: 12px; border-radius: 10px; border: 1px solid #334155;" />
          <button type="submit" class="btn btn-primary">Send Reset Link</button>
        </form>

        <p style="margin-top: 14px;">
          Remember your password? <a href="/login" style="color: #22d3ee;">Back to Login</a>
        </p>
      </div>
    </section>
  </body>
</html>
