<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password – CarHospi</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>

    <section>
      <div class="container" style="max-width: 460px; margin-top: 40px;">
        <h2>Reset Password</h2>
        <p style="color: var(--muted, #8a8aa8); margin: 10px 0 20px; font-size: .93rem; line-height: 1.6;">
          Enter your new password below to complete the reset.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
        <p style="color: #f87171; margin: 10px 0;"><%= error %></p>
        <% } %>

        <form action="/reset-password/<%= token %>" method="POST" style="display: grid; gap: 12px; margin-top: 14px;">
          <input type="password" name="password" placeholder="New password" required minlength="6" style="padding: 12px; border-radius: 10px; border: 1px solid #334155;" />
          <input type="password" name="confirmPassword" placeholder="Confirm new password" required minlength="6" style="padding: 12px; border-radius: 10px; border: 1px solid #334155;" />
          <button type="submit" class="btn btn-primary">Reset Password</button>
        </form>

        <p style="margin-top: 14px;">
          <a href="/login" style="color: #22d3ee;">← Back to Login</a>
        </p>
      </div>
    </section>
  </body>
</html>
